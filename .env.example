# Спільний каталог книг (Milestone 8.2, docs/SHARED_CATALOG.md, supabase/schema.sql) — щоб
# ISBNdb (платний) не викликався повторно на ту саму книгу різними користувачами. Core loop
# (Home, таймер, прогрес, нотатки — docs/LOCAL_FIRST.md) як і раніше повністю офлайн і НЕ
# залежить від цього — без ключів тут пошук/сканування ISBN просто пропускають цей крок і
# працюють так само, як до Milestone 8.2. Ніколи не додавай сюди service_role ключ — лише
# anon/publishable (він і призначений бути публічним у клієнтському застосунку; реальний
# захист — на боці Supabase, RLS + SECURITY DEFINER RPC, див. supabase/schema.sql).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Milestone 7 — пошук книг (docs/BOOK_PROVIDERS.md). Необов'язковий: без нього пошук і
# сканування ISBN так само працюють через Google Books без ключа, просто з нижчою квотою
# (можливі HTTP 429 при активному використанні).

# Безкоштовний ключ з Google Cloud Console — на порядки більша квота, ніж анонімні запити.
# Як отримати: console.cloud.google.com → створити проєкт → "APIs & Services" → Library →
# увімкнути "Books API" → Credentials → Create Credentials → API key → скопіювати сюди.
EXPO_PUBLIC_GOOGLE_BOOKS_API_KEY=

# ПЛАТНИЙ сервіс (isbndb.com, від $14.99/міс). З POLYTSIA V1.5 Фаза 1.1 (docs/SECURITY.md)
# сам ключ ISBNdb більше НЕ живе тут і взагалі ніде в клієнтському коді — платний ключ тепер
# виключно на сервері, як Supabase secret для `supabase/functions/isbndb-proxy/` (докладна
# інструкція розгортання — `supabase/functions/isbndb-proxy/README.md`, команда:
# `supabase secrets set ISBNDB_API_KEY=...`). Якщо в твоєму локальному `.env`/`.env.local`
# досі є рядок `EXPO_PUBLIC_ISBNDB_API_KEY=...` з доміграційних часів — його можна прибрати,
# застосунок його більше ніде не читає.
#
# Цей прапорець НЕ секрет (просто "0"/"1", безпечно бути в клієнтському бандлі) — окремий,
# свідомий power-switch: постав "1" лише ПІСЛЯ того, як задеплоїв `isbndb-proxy` і поставив
# реальний ключ через `supabase secrets set` (README.md вище). Без цього прапорця (чи без
# налаштованого Supabase) ISBNdb поводиться як звичайний вимкнений провайдер — не в
# пошуку/скані ISBN, решта застосунку працює як і раніше.
EXPO_PUBLIC_ISBNDB_PROXY_ENABLED=
